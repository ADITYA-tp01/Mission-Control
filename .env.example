# MissionControl - Environment Variables

# Model providers (used by TrueForge when it starts)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# TrueForge agent runtime
TRUEFORGE_URL=http://localhost:3000
# Optional bearer token if auth is enabled on the server
TRUEFORGE_API_KEY=

# Browser-side values for the embedded agent chat on the incident page.
# The token must be NEXT_PUBLIC to reach the browser; leave empty for local dev.
NEXT_PUBLIC_TRUEFORGE_URL=http://localhost:3000
NEXT_PUBLIC_TRUEFORGE_TOKEN=

# Demo Infrastructure MCP server
MCP_ENDPOINT=http://localhost:8000/mcp
DEMO_INFRA_API_URL=http://localhost:8001

# Set to false to inject chaos WITHOUT auto-triggering the agent webhook
AUTO_TRIGGER_AGENT=true

# Dashboard Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
